---
import { serverInfo } from '../data/serverInfo';
import Icon from './Icon.astro';
import IpField from './IpField.astro';

// Set to a real path (e.g. '/img/hero-spawn.webp') once a screenshot exists in public/.
// Leave null until then — the gradient below is the shipped state.
const heroImage: string | null = null;

const BTN_PRIMARY =
  'inline-flex items-center justify-center gap-2 rounded-none whitespace-nowrap px-8 py-4 text-body font-semibold text-white bg-action bevel hover:bg-action-hover active:bevel-inset transition-colors';
const BTN_DISCORD =
  'inline-flex items-center justify-center gap-2 rounded-none whitespace-nowrap px-8 py-4 text-body font-semibold text-ink bg-transparent border-2 border-edge-control hover:bg-discord hover:border-discord hover:text-white transition-colors';
const LINK_TERTIARY =
  'text-small text-ink-muted underline underline-offset-4 decoration-edge-control hover:text-accent hover:decoration-accent transition-colors';
---

<section class="relative overflow-hidden bg-surface pt-24 pb-20 lg:pt-28 lg:pb-24">
  {heroImage
    ? <>
        <img src={heroImage} alt="" width="2560" height="1440" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(var(--color-surface-rgb)/0.45)_0%,rgb(var(--color-surface-rgb)/0.92)_100%)]" aria-hidden="true"></div>
      </>
    : <div class="absolute inset-0 bg-[linear-gradient(180deg,var(--color-panel)_0%,var(--color-surface)_65%)]" aria-hidden="true"></div>
  }

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6">

    <p class="inline-flex items-center gap-2 bg-panel bevel rounded-none px-3 py-1.5 text-micro uppercase font-semibold text-ink mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-action-ink ring-2 ring-action-ink/25" aria-hidden="true"></span>
      Season 0 · Live
    </p>

    <h1 class="font-heading font-bold text-d3 sm:text-d2 lg:text-d1 text-ink mb-4">ProsperitySMP</h1>

    <p class="text-body sm:text-h3 text-ink-muted max-w-2xl mb-4">
      {serverInfo.tagline}
    </p>

    <p class="text-body text-ink-muted max-w-2xl mb-10">
      Take a job, sell what you dig up, and keep up with the rent.
      Java and Bedrock players share one map, one market, and one chat.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl mb-8">
      <IpField label="Java IP" value={serverInfo.ip} />
      <IpField label="Bedrock IP" value={serverInfo.bedrockIp} />
    </div>

    <p class="text-small text-ink-dim mb-10">
      {serverInfo.version} · {serverInfo.crossplay} · {serverInfo.whitelist}
    </p>

    <div class="flex flex-col sm:flex-row flex-wrap gap-3 mb-6">
      <a href="/getting-started" class={BTN_PRIMARY}>Get started</a>
      <a href={serverInfo.discord} target="_blank" rel="noopener noreferrer" class={BTN_DISCORD}>
        <Icon name="discord" size={18} />
        Join the Discord
      </a>
    </div>

    <p class="text-small text-ink-muted">
      <a href="https://wiki.prosperitysmp.com/Server_rules" class={LINK_TERTIARY}>Server rules</a>
      <span class="px-2 text-ink-dim" aria-hidden="true">·</span>
      <a href={serverInfo.wiki} target="_blank" rel="noopener noreferrer" class={LINK_TERTIARY}>Wiki</a>
      <span class="px-2 text-ink-dim" aria-hidden="true">·</span>
      <a href={serverInfo.economy} target="_blank" rel="noopener noreferrer" class={LINK_TERTIARY}>Economy dashboard</a>
    </p>
  </div>
</section>
<!-- Clipboard behaviour lives in IpField.astro so it works on every page that
     renders an IP field, not just the ones that render the hero. -->

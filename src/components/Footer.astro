---
import { footerNav } from '../data/navigation';
import { serverInfo } from '../data/serverInfo';
import Icon from './Icon.astro';

// `crossplay` is added to serverInfo in this same pass (spec §5.5). Read it
// defensively so the row can never render as a bare label.
const info: Record<string, string> = serverInfo;
const crossplay = info.crossplay ?? 'Java + Bedrock via Geyser';
---

<footer class="bg-surface border-t border-edge">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src="/logo.png" alt="" width="256" height="256" loading="lazy" decoding="async" class="h-7 w-auto" />
          <span class="font-heading text-accent font-bold">ProsperitySMP</span>
        </div>
        <p class="text-small text-ink-muted">Season 0. Java and Bedrock, same world, no whitelist.</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="text-micro uppercase font-semibold text-ink-dim mb-3">Navigation</h2>
        <ul class="space-y-2">
          {footerNav.map(link => (
            <li>
              <a href={link.href} class="text-small text-ink-muted hover:text-accent transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-micro uppercase font-semibold text-ink-dim mb-3">Server info</h2>
        <ul class="space-y-2 text-small text-ink-muted">
          <li>Version: <span class="text-ink font-mono">{serverInfo.version}</span></li>
          <li>Status: <span class="text-accent">{serverInfo.status}</span></li>
          <li>Whitelist: <span class="text-ink">{serverInfo.whitelist}</span></li>
          <li>Crossplay: <span class="text-ink">{crossplay}</span></li>
        </ul>
        <a
          href={serverInfo.discord}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-none whitespace-nowrap px-4 py-2.5 text-small font-semibold text-ink bg-transparent border-2 border-edge-control hover:bg-discord hover:border-discord hover:text-white transition-colors"
        >
          <Icon name="discord" size={16} />
          Join the Discord
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-edge text-center text-micro text-ink-dim">
      &copy; {new Date().getFullYear()} ProsperitySMP. All rights reserved.
    </div>
  </div>
</footer>

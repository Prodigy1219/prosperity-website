---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { serverInfo } from '../data/serverInfo';

// Fonts, self-hosted via @fontsource so they ship from our own origin. This
// replaces the Google Fonts <link>, which was a render-blocking stylesheet on a
// third-party host and cost two extra DNS/TLS handshakes before first paint.
// Only the weights actually used, latin subset only (the site is English-only).
// @fontsource registers the families as 'Cinzel', 'Inter' and 'JetBrains Mono',
// which is exactly what tailwind.config.mjs and global.css ask for.
import '@fontsource/cinzel/latin-700.css';          // display: h1/h2, logo
import '@fontsource/inter/latin-400.css';           // body
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';  // IPs, commands, inline code
import '@fontsource/jetbrains-mono/latin-600.css';

import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  extraSchema?: Record<string, unknown>[];
}

const {
  title,
  description = 'A cross-platform Minecraft survival economy server (Java + Bedrock) built around jobs, land ownership, skill trees, public projects, and a player-driven market.',
  ogImage = '/og-image.png',
  extraSchema = [],
} = Astro.props;

// Home page gets a keyword-rich title; inner pages get "Page — ProsperitySMP".
const siteTitle = title === 'ProsperitySMP'
  ? 'ProsperitySMP — Minecraft Survival Economy Server (Java + Bedrock)'
  : `${title} — ProsperitySMP`;

// Canonical + social URLs resolve against the real domain (astro.config `site`),
// not the vercel.app preview domain. Strip the trailing slash to match Vercel's
// cleanUrls / trailingSlash:false (so the canonical equals the actually-served URL).
const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = new URL(cleanPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Structured data so search engines understand the brand + site.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('#organization', Astro.site).href,
      name: serverInfo.name,
      alternateName: 'Prosperity SMP',
      url: new URL('/', Astro.site).href,
      logo: new URL('/logo.png', Astro.site).href,
      description:
        'A cross-platform Minecraft survival economy server (Java + Bedrock) built around jobs, land ownership, skill trees, and a player-driven market.',
      sameAs: [
        serverInfo.discord,
        'https://wiki.prosperitysmp.com',
        'https://economy.prosperitysmp.com',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: serverInfo.name,
      description,
      inLanguage: 'en',
      publisher: { '@id': new URL('#organization', Astro.site).href },
    },
    {
      '@type': 'VideoGame',
      '@id': new URL('#minecraft', Astro.site).href,
      name: 'Minecraft',
      url: 'https://www.minecraft.net/',
    },
    {
      '@type': 'GameServer',
      '@id': new URL('#gameserver', Astro.site).href,
      name: 'ProsperitySMP',
      url: new URL('/', Astro.site).href,
      game: { '@id': new URL('#minecraft', Astro.site).href },
      provider: { '@id': new URL('#organization', Astro.site).href },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: siteTitle,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': new URL('#website', Astro.site).href },
      about: { '@id': new URL('#gameserver', Astro.site).href },
    },
    ...extraSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#17140f" />

    <!-- Fonts are self-hosted (see the @fontsource imports above): same origin,
         no third-party preconnect, nothing render-blocking off-host. -->

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProsperitySMP" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ProsperitySMP — Minecraft survival economy server, Java and Bedrock"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <title>{siteTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-none focus:bg-accent focus:text-surface focus:font-semibold"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
